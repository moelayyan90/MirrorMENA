{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "build-this",
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": { "inline": true, "entry": "splash.html" },
      "market": { "entry": "app.html" }
    }
  },
  "server": { "dir": "dist/server", "entry": "index.cjs" },
  "permissions": { "reddit": true, "redis": true },
  "menu": {
    "items": [
      {
        "label": "BUILD THIS",
        "description": "Turn this post into a verified build request",
        "location": "post",
        "endpoint": "/internal/menu/build-this"
      },
      {
        "label": "Create BUILD THIS hub",
        "description": "Create the community demand market",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/create-hub"
      }
    ]
  },
  "triggers": { "onAppInstall": "/internal/triggers/app-install" },
  "dev": { "subreddit": "answer_debt_dev" },
  "scripts": { "dev": "vite build --watch", "build": "vite build" }
}
